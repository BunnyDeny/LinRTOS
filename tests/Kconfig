menuconfig ENABLE_TEST_CASES
	bool "Enable test cases"
	default n
	help
	  When enabled, you can select any number of test cases to build.
	  Each test registers itself via a linker section; test_runner.c
	  iterates the section and runs every registered test sequentially.
	  Results are printed to serial.  No per-test re-flash needed.

if ENABLE_TEST_CASES

config TEST_STATE
	bool "Task state query"
	help
	  Verify rtos_task_get_state / get_priority / get_current.

config TEST_MUTEX_BASIC
	bool "Mutex basic (take/give/ownership)"
	help
	  Verify rtos_mutex_init, take, give, holder query,
	  and non-holder give rejection.

config TEST_MUTEX_RECURSIVE
	bool "Mutex recursive (nested take/give)"
	help
	  Verify rtos_mutex_init_recursive, take_recursive,
	  give_recursive, count tracking, and blocking.

config TEST_MUTEX_PRIORITY
	bool "Mutex priority inheritance"
	help
	  Verify priority boosting when high-priority task
	  blocks on mutex held by low-priority task.

config TEST_SEMAPHORE_BINARY
	bool "Semaphore binary (give/take)"
	help
	  Verify rtos_semaphore_init_binary, give, take,
	  and producer-consumer synchronization.

config TEST_SEMAPHORE_COUNTING
	bool "Semaphore counting (multi producer)"
	help
	  Verify rtos_semaphore_init_counting, multi-give,
	  multi-take, and max-count boundary.

config TEST_SEMAPHORE_ISR
	bool "Semaphore ISR-safe give_from_isr"
	help
	  Verify rtos_semaphore_give_from_isr in SysTick
	  interrupt context with a consumer task.

config TEST_QUEUE_BASIC
	bool "Queue basic API (send/recv/front/overwrite/peek)"
	help
	  Verify rtos_queue_init, send, recv, front-insert,
	  overwrite, peek, and status query APIs.

config TEST_QUEUE_BLOCKING
	bool "Queue blocking and timeout"
	help
	  Verify blocking send/recv, producer-consumer sync,
	  and timeout behaviors.

config TEST_QUEUE_ISR
	bool "Queue ISR-safe send_from_isr"
	help
	  Verify rtos_queue_generic_send_from_isr in SysTick
	  interrupt context with a consumer task.

config TEST_SUSPEND_RESUME
	bool "Task suspend and resume (external)"
	help
	  Verify rtos_task_suspend / rtos_task_resume APIs
	  with external control.

config TEST_SELF_SUSPEND
	bool "Task self-suspend suspend(NULL)"
	help
	  Verify rtos_task_suspend(NULL) self-suspend
	  and external resume.

config TEST_PRIORITY
	bool "Dynamic priority change"
	help
	  Verify rtos_task_set_priority and preemption
	  after priority change.

config TEST_SELFDELETE
	bool "Self-delete and TCB recycle"
	help
	  Verify self-delete with idle task TCB recycle
	  and reuse by subsequent rtos_task_create.

config TEST_SCHED_LOCK
	bool "Scheduler lock single/nested"
	help
	  Verify rtos_sched_lock / rtos_sched_unlock,
	  single-level and nested locking.

config TEST_YIELD
	bool "Task yield (same-priority round-robin)"
	help
	  Verify rtos_task_yield alternation between
	  same-priority tasks.

config TEST_DELAY_UNTIL
	bool "Absolute periodic delay (delay_until)"
	help
	  Verify rtos_task_delay_until periodic accuracy.

config TEST_STACK_FREE
	bool "Stack free query"
	help
	  Verify rtos_task_get_stack_free returns
	  a reasonable value within bounds.

config TEST_ABORT_DELAY
	bool "Abort delay (force wake blocked task)"
	help
	  Verify rtos_task_abort_delay wakes a blocked
	  task and rtos_scheduler_is_running reports true.

config TEST_FPU
	bool "FPU context switch (Cortex-M4F)"
	help
	  Multi-task preemption with FPU register verification.
	  Requires FPU hardware.

config TEST_CM_BACKTRACE
	bool "CmBacktrace integration"
	depends on COMPONENT_CM_BACKTRACE
	help
	  Verify CmBacktrace initialization, call stack backtrace,
	  and firmware info output.

config TEST_WORKQUEUE
	bool "Workqueue scheduling"
	depends on WORKQUEUE
	help
	  Verify immediate and delayed work scheduling.

config TEST_BASIC_TASKS
	bool "Basic multi-task + delay + preemption"
	help
	  Visual test: multi-task creation, delay, delay_until,
	  and priority preemption.  Best observed via serial log.

endif
